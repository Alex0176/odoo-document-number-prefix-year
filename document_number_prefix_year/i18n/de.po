#. module: document_number_prefix_year
#. odoo-python
#: code:addons/document_number_prefix_year/models/numbering.py
msgid "New"
msgstr "Neu"

#. module: document_number_prefix_year
msgid "New Number on Confirmation"
msgstr "Neue Nummer beim Bestätigen"

#. module: document_number_prefix_year
msgid "Number = prefix + year + counter, e.g. AN26000001. The counter restarts every year and always continues after the highest existing number of that year (also numbers imported from other systems)."
msgstr "Nummer = Präfix + Jahr + Zähler, z. B. AN26000001. Der Zähler beginnt jedes Jahr neu und schließt immer an die höchste vorhandene Nummer dieses Jahres an (auch an aus anderen Systemen importierte Nummern)."

#. module: document_number_prefix_year
msgid "Number of the quotation this order was confirmed from."
msgstr "Nummer des Angebots, aus dem dieser Auftrag bestätigt wurde."

#. module: document_number_prefix_year
#. odoo-python
#: code:addons/document_number_prefix_year/models/res_company.py
#, python-format
msgid "Prefix “%(prefix)s” must not contain spaces or end with a digit."
msgstr "Das Präfix „%(prefix)s“ darf keine Leerzeichen enthalten und nicht mit einer Ziffer enden."

